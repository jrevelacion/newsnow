{
  "name": "newsnow",
  "main": "server/worker.mjs",
  "compatibility_date": "2024-10-16",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "exclude": ["server/**", "shared/**", "src/**", ".git/**", "node_modules/**"]
  },
  "d1_databases": [
    {
      "binding": "NEWSNOW_DB",
      "database_name": "newsnow-db",
      "database_id": "YOUR_D1_DATABASE_ID_HERE"
    }
  ],
  "observability": {
    "enabled": true
  }
}
