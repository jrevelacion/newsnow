{
  "name": "newsnow",
  "main": "dist/server-bundle/index.mjs",
  "compatibility_date": "2024-10-16",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "assets": {
    "directory": "./dist/output/public",
    "binding": "ASSETS",
    "exclude": ["_worker.js/**"]
  },
  "d1_databases": [
    {
      "binding": "NEWSNOW_DB",
      "database_name": "newsnow-db",
      "database_id": "YOUR_D1_DATABASE_ID_HERE"
    }
  ],
  "observability": {
    "enabled": true
  }
}
